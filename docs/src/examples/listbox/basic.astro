<div id="listbox-basic">
  <span id="listbox-basic-label">Fruit</span>
  <ul class="list">
    <li>Apple</li>
    <li aria-disabled="true">Banana</li>
    <li>Cherry</li>
    <li>Grape</li>
    <li>Avocado</li>
  </ul>
</div>

<script>
  import { ListboxController } from "appret/listbox";

  const host = document.querySelector<HTMLElement>("#listbox-basic")!;
  const options = [...host.querySelectorAll<HTMLElement>(".list > li")];

  new ListboxController(host, {
    list: host.querySelector(".list")!,
    options,
    label: { byId: "listbox-basic-label" },
    selectionFollowsFocus: true,
    initialSelection: options[2],
  });
</script>
