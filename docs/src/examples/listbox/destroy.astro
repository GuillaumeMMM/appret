<div id="listbox-destroy">
  <p><button type="button" class="toggle">Destroy</button></p>
  <ul class="list">
    <li>Apple</li>
    <li>Banana</li>
    <li>Cherry</li>
  </ul>
</div>

<script>
  import { ListboxController } from "appret/listbox";

  const host = document.querySelector<HTMLElement>("#listbox-destroy")!;
  const toggle = host.querySelector<HTMLElement>(".toggle")!;

  function setUp() {
    return new ListboxController(host, {
      list: host.querySelector(".list")!,
      options: [...host.querySelectorAll<HTMLElement>(".list > li")],
      label: "Fruit",
    });
  }

  let controller: ListboxController | undefined = setUp();

  toggle.addEventListener("click", () => {
    if (controller) {
      controller.destroy();
      controller = undefined;
      toggle.textContent = "Set up again";
    } else {
      controller = setUp();
      toggle.textContent = "Destroy";
    }
  });
</script>
