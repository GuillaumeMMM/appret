<appret-tabs id="select-example" label="Account">
  <div data-appret-part="tabs.list">
    <button data-appret-part="tabs.tab">Profile</button>
    <button data-appret-part="tabs.tab">Billing</button>
    <button data-appret-part="tabs.tab">About</button>
  </div>
  <section data-appret-part="tabs.panel">Profile panel</section>
  <section data-appret-part="tabs.panel">Billing panel</section>
  <section data-appret-part="tabs.panel">About panel</section>
</appret-tabs>
<p>
  <button type="button" id="select-example-billing">Show billing</button>
  Last change: <output id="select-example-output">none yet</output>
</p>

<script>
  import "appret/define/tabs";

  const tabs = document.querySelector<HTMLElementTagNameMap["appret-tabs"]>("#select-example")!;
  const output = document.querySelector("#select-example-output")!;

  document.querySelector("#select-example-billing")!.addEventListener("click", () => {
    tabs.select(1);
  });

  tabs.addEventListener("appret-tabs-change", (event) => {
    output.textContent = `${event.detail.tab.textContent} (index ${event.detail.index})`;
  });
</script>
