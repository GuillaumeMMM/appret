API update selected
<button type="button" id="api-selected">Select 2nd tab</button>
<div class="demo-api-selected">
  <div data-appret-part="tabs.list">
    <button data-appret-part="tabs.tab">Profile</button>
    <button data-appret-part="tabs.tab">Billing</button>
    <button data-appret-part="tabs.tab">About</button>
  </div>
  <section data-appret-part="tabs.panel">Profile panel</section>
  <section data-appret-part="tabs.panel">Billing panel</section>
  <section data-appret-part="tabs.panel">About panel</section>
</div>

<script>
  import { TabsController } from "appret/tabs";

  for (const host of document.querySelectorAll<HTMLElement>(".demo-default")) {
    new TabsController(host, {
      list: host.querySelector('[data-appret-part~="tabs.list"]')!,
      tabs: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.tab"]'),
      ),
      panels: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.panel"]'),
      ),
      label: "Choose a tab",
    });
  }

  for (const host of document.querySelectorAll<HTMLElement>(".demo-disabled")) {
    new TabsController(host, {
      list: host.querySelector('[data-appret-part~="tabs.list"]')!,
      tabs: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.tab"]'),
      ),
      panels: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.panel"]'),
      ),
      label: "Choose a tab",
    });
  }

  for (const host of document.querySelectorAll<HTMLElement>(".demo-vertical")) {
    new TabsController(host, {
      list: host.querySelector('[data-appret-part~="tabs.list"]')!,
      tabs: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.tab"]'),
      ),
      panels: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.panel"]'),
      ),
      label: "Choose a tab",
      orientation: "vertical",
    });
  }

  for (const host of document.querySelectorAll<HTMLElement>(".demo-manual")) {
    new TabsController(host, {
      list: host.querySelector('[data-appret-part~="tabs.list"]')!,
      tabs: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.tab"]'),
      ),
      panels: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.panel"]'),
      ),
      label: "Choose a tab",
      activation: "manual",
    });
  }

  for (const host of document.querySelectorAll<HTMLElement>(".demo-rtl")) {
    new TabsController(host, {
      list: host.querySelector('[data-appret-part~="tabs.list"]')!,
      tabs: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.tab"]'),
      ),
      panels: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.panel"]'),
      ),
      label: "Choose a tab",
    });
  }

  for (const host of document.querySelectorAll<HTMLElement>(".demo-noloop")) {
    new TabsController(host, {
      list: host.querySelector('[data-appret-part~="tabs.list"]')!,
      tabs: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.tab"]'),
      ),
      panels: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.panel"]'),
      ),
      label: "Choose a tab",
      loop: false,
    });
  }

  const hostApiUpdated: HTMLElement =
    document.querySelector(".demo-api-update")!;
  const tabsApiUpdated = Array.from(
    hostApiUpdated.querySelectorAll<HTMLElement>(
      '[data-appret-part~="tabs.tab"]',
    ),
  );

  const panelsApiUpdated = Array.from(
    hostApiUpdated.querySelectorAll<HTMLElement>(
      '[data-appret-part~="tabs.panel"]',
    ),
  );
  const controllerApiUpdate = new TabsController(hostApiUpdated, {
    list: hostApiUpdated.querySelector('[data-appret-part~="tabs.list"]')!,
    tabs: tabsApiUpdated,
    panels: Array.from(
      hostApiUpdated.querySelectorAll<HTMLElement>(
        '[data-appret-part~="tabs.panel"]',
      ),
    ),
    label: "Choose a tab",
  });

  document.getElementById("api-update")?.addEventListener("click", () => {
    {
      tabsApiUpdated[2].remove();
      panelsApiUpdated[2].remove();

      controllerApiUpdate.update({
        tabs: tabsApiUpdated.slice(0, 2).map((t, i) => {
          t.textContent = `Updated ${i}`;
          return t;
        }),
        panels: panelsApiUpdated.slice(0, 2),
      });
    }
  });

  const hostApiSelected: HTMLElement =
    document.querySelector(".demo-api-selected")!;
  const tabsApiSelected = Array.from(
    hostApiSelected.querySelectorAll<HTMLElement>(
      '[data-appret-part~="tabs.tab"]',
    ),
  );
  const controllerApiSelected = new TabsController(hostApiSelected, {
    list: hostApiSelected.querySelector('[data-appret-part~="tabs.list"]')!,
    tabs: tabsApiSelected,
    panels: Array.from(
      hostApiSelected.querySelectorAll<HTMLElement>(
        '[data-appret-part~="tabs.panel"]',
      ),
    ),
    label: "Choose a tab",
  });

  document.getElementById("api-selected")?.addEventListener("click", () => {
    {
      controllerApiSelected.select(1);
    }
  });
</script>
