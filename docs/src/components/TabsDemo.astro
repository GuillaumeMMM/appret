<div class="demo">
  <div data-appret-part="tabs.list">
    <button data-appret-part="tabs.tab">Profile</button>
    <button data-appret-part="tabs.tab">Billing</button>
  </div>
  <section data-appret-part="tabs.panel">Profile panel</section>
  <section data-appret-part="tabs.panel">Billing panel</section>
</div>

<script>
  import { TabsController } from "appret/tabs";

  for (const host of document.querySelectorAll<HTMLElement>(".demo")) {
    new TabsController(host, {
      tablist: host.querySelector('[data-appret-part~="tabs.list"]')!,
      tabs: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.tab"]'),
      ),
      tabpanels: Array.from(
        host.querySelectorAll<HTMLElement>('[data-appret-part~="tabs.panel"]'),
      ),
    });
  }
</script>
