{
  "name": "appret",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./dist/define/*.js",
    "./src/define/*.ts"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "appret:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tabs": {
      "appret:source": "./src/tabs/index.ts",
      "types": "./dist/tabs/index.d.ts",
      "default": "./dist/tabs/index.js"
    },
    "./listbox": {
      "appret:source": "./src/listbox/index.ts",
      "types": "./dist/listbox/index.d.ts",
      "default": "./dist/listbox/index.js"
    },
    "./menu": {
      "appret:source": "./src/menu/index.ts",
      "types": "./dist/menu/index.d.ts",
      "default": "./dist/menu/index.js"
    },
    "./define/tabs": {
      "appret:source": "./src/define/tabs.ts",
      "types": "./dist/define/tabs.d.ts",
      "default": "./dist/define/tabs.js"
    },
    "./define/listbox": {
      "appret:source": "./src/define/listbox.ts",
      "types": "./dist/define/listbox.d.ts",
      "default": "./dist/define/listbox.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
