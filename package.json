{
  "name": "appret-monorepo",
  "private": true,
  "workspaces": [
    "packages/appret",
    "docs"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/appret & npm run docs:dev",
    "lib:dev": "npm run dev --workspace=packages/appret",
    "build:lib": "npm run build --workspace=packages/appret",
    "docs:dev": "npm run dev --workspace=docs",
    "docs:build": "npm run build --workspace=docs",
    "build": "npm run build:lib && npm run docs:build"
  }
}
